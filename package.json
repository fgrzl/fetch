{
  "name": "@fgrzl/fetch",
  "version": "2.0.0",
  "description": "Explicit TypeScript fetch client with typed result objects and opt-in middleware",
  "keywords": [
    "fetch",
    "typescript",
    "api",
    "http",
    "http-client",
    "middleware",
    "typed-results",
    "abort",
    "timeout",
    "type-safe"
  ],
  "homepage": "https://github.com/fgrzl/fetch#readme",
  "bugs": {
    "url": "https://github.com/fgrzl/fetch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgrzl/fetch.git"
  },
  "license": "Apache-2.0",
  "author": "smiggleworth",
  "type": "module",
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware/index.d.ts",
        "default": "./dist/middleware/index.js"
      },
      "require": {
        "types": "./dist/middleware/index.d.cts",
        "default": "./dist/middleware/index.cjs"
      }
    },
    "./middleware/authentication": {
      "import": {
        "types": "./dist/middleware/authentication/index.d.ts",
        "default": "./dist/middleware/authentication/index.js"
      },
      "require": {
        "types": "./dist/middleware/authentication/index.d.cts",
        "default": "./dist/middleware/authentication/index.cjs"
      }
    },
    "./middleware/authorization": {
      "import": {
        "types": "./dist/middleware/authorization/index.d.ts",
        "default": "./dist/middleware/authorization/index.js"
      },
      "require": {
        "types": "./dist/middleware/authorization/index.d.cts",
        "default": "./dist/middleware/authorization/index.cjs"
      }
    },
    "./middleware/cache": {
      "import": {
        "types": "./dist/middleware/cache/index.d.ts",
        "default": "./dist/middleware/cache/index.js"
      },
      "require": {
        "types": "./dist/middleware/cache/index.d.cts",
        "default": "./dist/middleware/cache/index.cjs"
      }
    },
    "./middleware/csrf": {
      "import": {
        "types": "./dist/middleware/csrf/index.d.ts",
        "default": "./dist/middleware/csrf/index.js"
      },
      "require": {
        "types": "./dist/middleware/csrf/index.d.cts",
        "default": "./dist/middleware/csrf/index.cjs"
      }
    },
    "./middleware/logging": {
      "import": {
        "types": "./dist/middleware/logging/index.d.ts",
        "default": "./dist/middleware/logging/index.js"
      },
      "require": {
        "types": "./dist/middleware/logging/index.d.cts",
        "default": "./dist/middleware/logging/index.cjs"
      }
    },
    "./middleware/rate-limit": {
      "import": {
        "types": "./dist/middleware/rate-limit/index.d.ts",
        "default": "./dist/middleware/rate-limit/index.js"
      },
      "require": {
        "types": "./dist/middleware/rate-limit/index.d.cts",
        "default": "./dist/middleware/rate-limit/index.cjs"
      }
    },
    "./middleware/retry": {
      "import": {
        "types": "./dist/middleware/retry/index.d.ts",
        "default": "./dist/middleware/retry/index.js"
      },
      "require": {
        "types": "./dist/middleware/retry/index.d.cts",
        "default": "./dist/middleware/retry/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors/index.d.ts",
        "default": "./dist/errors/index.js"
      },
      "require": {
        "types": "./dist/errors/index.d.cts",
        "default": "./dist/errors/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "vp exec rimraf dist coverage .vitest-attachments",
    "dev": "vp dev dev --port 3000 --open",
    "build": "vp pack",
    "check": "vp check",
    "prepublishOnly": "npm run build",
    "fmt": "vp fmt . --write",
    "fmt:check": "vp fmt . --check",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "lint:check": "vp lint .",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "bench": "vp test bench --run"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite-plus": "0.1.23"
  }
}
