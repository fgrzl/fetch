{
  "name": "@fgrzl/fetch",
  "version": "2.0.0",
  "description": "A modern, type-safe HTTP client with middleware support for CSRF protection and authentication",
  "keywords": [
    "fetch",
    "typescript",
    "api",
    "http",
    "client",
    "middleware",
    "CSRF",
    "auth",
    "type-safe"
  ],
  "homepage": "https://github.com/fgrzl/fetch#readme",
  "bugs": {
    "url": "https://github.com/fgrzl/fetch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgrzl/fetch.git"
  },
  "license": "MIT",
  "author": "smiggleworth",
  "type": "module",
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./min": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.min.js",
      "require": "./dist/index.min.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js",
      "require": "./dist/middleware/index.cjs"
    },
    "./middleware/authentication": {
      "types": "./dist/middleware/authentication/index.d.ts",
      "import": "./dist/middleware/authentication/index.js",
      "require": "./dist/middleware/authentication/index.cjs"
    },
    "./middleware/authorization": {
      "types": "./dist/middleware/authorization/index.d.ts",
      "import": "./dist/middleware/authorization/index.js",
      "require": "./dist/middleware/authorization/index.cjs"
    },
    "./middleware/cache": {
      "types": "./dist/middleware/cache/index.d.ts",
      "import": "./dist/middleware/cache/index.js",
      "require": "./dist/middleware/cache/index.cjs"
    },
    "./middleware/csrf": {
      "types": "./dist/middleware/csrf/index.d.ts",
      "import": "./dist/middleware/csrf/index.js",
      "require": "./dist/middleware/csrf/index.cjs"
    },
    "./middleware/logging": {
      "types": "./dist/middleware/logging/index.d.ts",
      "import": "./dist/middleware/logging/index.js",
      "require": "./dist/middleware/logging/index.cjs"
    },
    "./middleware/rate-limit": {
      "types": "./dist/middleware/rate-limit/index.d.ts",
      "import": "./dist/middleware/rate-limit/index.js",
      "require": "./dist/middleware/rate-limit/index.cjs"
    },
    "./middleware/retry": {
      "types": "./dist/middleware/retry/index.d.ts",
      "import": "./dist/middleware/retry/index.js",
      "require": "./dist/middleware/retry/index.cjs"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "require": "./dist/errors/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "vp exec rimraf dist coverage .vitest-attachments",
    "dev": "vp dev dev --port 3000 --open",
    "build": "vp pack",
    "check": "vp check",
    "prepublishOnly": "npm run build",
    "fmt": "vp fmt . --write",
    "fmt:check": "vp fmt . --check",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "lint:check": "vp lint .",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "bench": "vp test bench --run"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite-plus": "0.1.22"
  }
}
